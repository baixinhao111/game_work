{
  "name": "monday-breakout-ddl-frontline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "sim": "esbuild scripts/balance-sim.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/balance-sim.mjs && node node_modules/.cache/balance-sim.mjs"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
